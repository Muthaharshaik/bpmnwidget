<?xml version="1.0" encoding="utf-8"?>
<widget id="lowcodelabs.bpmnwidget.Bpmnwidget" pluginWidget="true" needsEntityContext="true" offlineCapable="true"
        supportedPlatform="Web"
        xmlns="http://www.mendix.com/widget/1.0/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.mendix.com/widget/1.0/ ../node_modules/mendix/custom_widget.xsd">
    <name>Bpmnwidget</name>
    <description>The widget is used to visualize, create and modify the business process diagrams.</description>
    <icon/>
       <properties>
        <!-- Input: BPMN XML Content -->
        <propertyGroup caption="Data">
            <property key="bpmnXML" type="attribute" required="false">
                <caption>BPMN XML</caption>
                <description>The BPMN diagram XML content</description>
                <attributeTypes>
                    <attributeType name="String"/>
                    <attributeType name="HashString"/>
                </attributeTypes>
            </property>

            <property key="previewImageAttr" type="attribute" required="false">
                <caption>Preview Image</caption>
                <description>Base64 encoded SVG preview of the diagram</description>
                <attributeTypes>
                    <attributeType name="String"/>
                    <attributeType name="HashString"/>
                </attributeTypes>
            </property>

            <property key="bpmnName" type="attribute" required="false">
                <caption>BPMN Name</caption>
                <description>BPMN File Name</description>
                <attributeTypes>
                    <attributeType name="String"/>
                </attributeTypes>
            </property>

            <property key="currentUserEmail" type="expression" required="false">
                <caption>Current User Email</caption>
                <description>Current user email</description>
                <returnType type="String"/>
            </property>

            <property key="lockedUserEmail" type="attribute" required="false">
                <caption>Locked User Email</caption>
                <description>Email of user who has checked out this BPMN</description>
                <attributeTypes>
                    <attributeType name="String"/>
                </attributeTypes>
            </property>

        </propertyGroup>

        <!-- Compare mode: only used when Mode = Compare -->
        <propertyGroup caption="Comparison">
            <property key="compareXML" type="attribute" required="false">
                <caption>Compare XML</caption>
                <description>Only used when Mode is Compare. BPMN XML of the version the user picked in the dropdown. The widget compares it against BPMN XML.</description>
                <attributeTypes>
                    <attributeType name="String"/>
                    <attributeType name="HashString"/>
                </attributeTypes>
            </property>

            <property key="compareVersionName" type="attribute" required="false">
                <caption>Compare Version Name</caption>
                <description>Only used when Mode is Compare. Name of the selected version, e.g. v01. Shown as the heading above the compared diagram.</description>
                <attributeTypes>
                    <attributeType name="String"/>
                    <attributeType name="Integer"/>
                    <attributeType name="Long"/>
                </attributeTypes>
            </property>

            <property key="currentVersionName" type="attribute" required="false">
                <caption>Current Version Name</caption>
                <description>Only used when Mode is Compare. Name of the current version, e.g. v03. Shown as the heading above the current diagram. Defaults to "Current".</description>
                <attributeTypes>
                    <attributeType name="String"/>
                    <attributeType name="Integer"/>
                    <attributeType name="Long"/>
                </attributeTypes>
            </property>
        </propertyGroup>

        <!-- Actions -->
        <propertyGroup caption="Events">
            <property key="onSaveAction" type="action" required="false">
                <caption>On Save</caption>
                <description>Action triggered when the user saves the BPMN diagram</description>
            </property>

            <property key="onCancelAction" type="action" required="false">
                <caption>On Cancel</caption>
                <description>Action triggered when the user cancels editing</description>
            </property>


            <property key="taskDataJson" type="attribute" required="false">
                <caption>Task Data JSON</caption>
                <description>JSON containing updated task master data</description>
                <attributeTypes>
                    <attributeType name="String"/>
                    <attributeType name="HashString"/>
                </attributeTypes>
            </property>

            <property key="selectedTaskId" type="attribute" required="false">
                <caption>Selected Task ID</caption>
                <description>Stores the ID of the task clicked in the diagram</description>
                <attributeTypes>
                    <attributeType name="String"/>
                </attributeTypes>
            </property>

            <property key="onTaskClickAction" type="action" required="false">
                <caption>On Task Click</caption>
                <description>Action triggered when a task is clicked in the diagram. Use Selected Task ID attribute to get the task ID.</description>
            </property>

            <property key="onCompareAction" type="action" required="false">
                <caption>On Show Comparison</caption>
                <description>Action triggered by Display > Show Comparison. Point this at the microflow that opens your comparison page. The menu item is hidden when this is left empty.</description>
            </property>

        </propertyGroup>

        <!--Display-->
        <propertyGroup caption="Display">
            <property key="mode" type="enumeration" defaultValue="editor">
                <caption>Mode</caption>
                <description>Editor shows the modelling canvas. Compare shows a read-only side-by-side comparison of BPMN XML against Compare XML - place the widget in Compare mode on a dedicated comparison page.</description>
                <enumerationValues>
                    <enumerationValue key="editor">Editor</enumerationValue>
                    <enumerationValue key="compare">Compare</enumerationValue>
                </enumerationValues>
            </property>

            <property key="readOnly" type="boolean" defaultValue="false">
                <caption>Read Only</caption>
                <description>If true, the diagram cannot be edited</description>
            </property>
        </propertyGroup>

    </properties>
</widget>